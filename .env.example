# Public flags. Leave these off to ship only the free browser reader.
# `next dev` reads `.env.local`. Cloudflare preview reads `.dev.vars`.
# `npm run deploy:dev` bakes `.env.local` / `.env` into the Worker, then deploys env `dev`.
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_AUTH_ENABLED=false
# Paid Stripe checkout. Leave off so Plus/Pro/pack CTAs toast “Coming soon”.
NEXT_PUBLIC_CHECKOUT_ENABLED=false
# One-off cloud trial on first sign-in. New users only; existing usage rows keep their quota.
NEXT_PUBLIC_TRIAL_MINUTES=10

# Google + NextAuth. Required together before the sign-in button is useful.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Comma-separated. Those Google accounts see the Admin tab on /account.
ADMIN_EMAILS=

# Users / orders / usage live in the D1 binding `DB` (wrangler.jsonc), not a URL.
# Apply schema: npm run db:migrate:local  (and npm run db:migrate for remote)

# Stripe. Checkout, portal and webhook stay 503 until these exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Atlas Cloud. Only the Worker should hold this. Never send it to the browser.
ATLASCLOUD_API_KEY=
