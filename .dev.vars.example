# Copy to `.dev.vars` for `npm run preview` / wrangler. Not used by `next dev` (that is `.env.local`).
# Same keys as `.env.example`. Do not commit `.dev.vars`.

NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_TRIAL_MINUTES=10
NEXT_PUBLIC_CHECKOUT_ENABLED=false
NEXT_PUBLIC_WEB_URL=http://localhost:8788

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
ADMIN_EMAILS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

ATLASCLOUD_API_KEY=
